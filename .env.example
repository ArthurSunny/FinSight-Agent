# ============================================================
# FinSight-Agent 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交）
#   PowerShell: Copy-Item .env.example .env
# ============================================================

# ---- LLM 凭据（Phase 2 多智能体编排必需；Phase 1 计算引擎不依赖）----
# 申请地址：https://platform.deepseek.com/api_keys
# 安全约定：本项目任何日志 / 终端输出 / 报告产物都不得出现该字符串原文（见 AGENTS.md §5.6）
DEEPSEEK_API_KEY=
# 可选：自定义网关地址（留空使用官方默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat

# ---- Phase 2 编排参数 ----
# api = 调用真实 DeepSeek；offline = 确定性模板（无需密钥，用于跑通工作流与 CI）
FINSIGHT_LLM_MODE=api
FINSIGHT_LLM_TEMPERATURE=0.3
# 并行分析节点（结构化 JSON）的输出上限
FINSIGHT_LLM_MAX_TOKENS=4096
# 首席撰稿节点（六章节 Markdown）的输出上限，过低会导致报告尾部被截断
FINSIGHT_EDITOR_MAX_TOKENS=8192

# ---- 数据层配置（Phase 1）----
# 原始三表本地缓存有效期（小时），过期后自动重新拉取
FINSIGHT_CACHE_TTL_HOURS=12

# ---- 运行模式 ----
# dev: 打印调试信息；prod: 仅输出结构化结果
FINSIGHT_ENV=dev
